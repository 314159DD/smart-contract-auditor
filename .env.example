# Copy this file to .env and fill in your values

# OpenRouter AI (supports Claude, GPT, etc.)
OPENROUTER_API_KEY=sk-or-v1-...
AI_MODEL=anthropic/claude-sonnet-4-6

# Supabase (Auth + Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Etherscan API (optional — free tier works without key but is rate-limited)
ETHERSCAN_API_KEY=

# Stripe (Billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# Email notifications (Resend — https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@contractauditor.app

# Frontend URL (used in email links and share URLs)
FRONTEND_URL=http://localhost:3000

# Alert webhook (optional): receives a POST for every CRITICAL/HIGH finding
ALERT_WEBHOOK_URL=

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
